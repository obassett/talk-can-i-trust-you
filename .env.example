# Copy to .env for local (non-docker) runs. In docker-compose these are set
# per-service, so you don't need this file for `just up`.
#
# NOTE: `just up` (bootstrap.sh) writes SPIRE_AGENT_JOIN_TOKEN into .env at runtime
# so the agent's config stays stable across compose commands. It updates only that
# key and preserves anything else you put here.

# Where Order dials Dispatch when running both on your host:
DISPATCH_HOST=127.0.0.1
DISPATCH_PORT=8443

# The Workload API socket your SPIRE agent exposes. The SPIFFE libraries read
# this automatically. Example (adjust to your agent):
SPIFFE_ENDPOINT_SOCKET=unix:///run/spire/sockets/api.sock
